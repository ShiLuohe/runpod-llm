
# RunPod development image with CUDA 12.9
FROM runpod/pytorch:2.2.0-rc.229-cu1290-torch291-ubuntu2404

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_CACHE_DIR=/tmp/uv-cache
ENV UV_LINK_MODE=copy
ENV HF_HOME=/workspace/huggingface
ENV TRITON_CACHE_DIR=/tmp/triton-cache
ENV TORCH_HOME=/tmp/torch-cache

# Useful development tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git git-lfs curl wget tmux vim nano htop \
    build-essential ninja-build cmake && \
    rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv

# Create a separate Python 3.12 environment
RUN uv python install 3.12 && \
    uv venv --python 3.12 /opt/llm

ENV VIRTUAL_ENV=/opt/llm
ENV PATH="/opt/llm/bin:${PATH}"

# Install vLLM with its matching PyTorch dependencies
RUN uv pip install --python /opt/llm/bin/python \
    "vllm==0.33.0" --torch-backend=cu130

# Install training and data libraries
COPY requirements.txt /tmp/requirements.txt

RUN uv pip install --python /opt/llm/bin/python \
    -r /tmp/requirements.txt && \
    uv pip check --python /opt/llm/bin/python && \
    rm -rf /tmp/uv-cache

# Basic import test
RUN python -c "import torch, vllm, trl, datasets; print('Imports OK')"

WORKDIR /workspace

# Preserve RunPod's original SSH/Jupyter startup
